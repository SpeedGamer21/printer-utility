<UserControl x:Class="PrinterUtility.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrinterUtility">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40" MaxWidth="1040">
            <TextBlock Text="Tools" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Quick repairs and diagnostics. Buttons with a shield ask for administrator rights." />

            <!-- spooler -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Print spooler" />
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Tile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="Restart Print Spooler" FontWeight="SemiBold" />
                            <TextBlock Text="Fixes most 'offline' or 'not responding' printers." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Tag="&#xEA18;" Content="Restart" VerticalAlignment="Center" Click="RestartSpooler_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE894;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="Clear stuck print jobs" FontWeight="SemiBold" />
                            <TextBlock Text="Deletes every pending job on this PC and restarts the spooler." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Tag="&#xEA18;" Content="Clear" VerticalAlignment="Center" Click="ClearSpooler_Click" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- diagnose -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Diagnose a print server" />
            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="Checks name resolution, ping, SMB (445), RPC (135) and the remote spooler, then lists its shared printers."
                               Style="{StaticResource Caption}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox x:Name="Server" Width="320" Uid="NoSubmit" Tag="Server name or IP" KeyDown="Server_KeyDown" />
                        <Button Style="{StaticResource AccentButton}" Tag="&#xE9D9;" Content="Run diagnosis" Margin="8,0,0,0" Click="Diagnose_Click" />
                        <Button Tag="&#xE721;" Content="Browse printers" Margin="8,0,0,0" Click="Browse_Click" />
                    </StackPanel>
                    <ItemsControl x:Name="Results" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LogEntry}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource ToneIcon}" Tag="{Binding Tone}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Body}" FontSize="13" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- credentials -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Credential Manager" />
            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" VerticalAlignment="Top"><TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="Credential Manager – Windows credentials for printers" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Saves the user name and password of a print server / sharing PC for the current user, exactly like Credential Manager (blocked with Control Panel). Use it when the credential prompt rejects every password – common on domain-joined PCs printing to a workgroup PC. A plain user name is saved as SERVER\user." />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" Tag="&#xE710;" Content="Add credential" VerticalAlignment="Center" Click="SaveCredential_Click" />
                    </Grid>

                    <TextBlock x:Name="SavedEmpty" Style="{StaticResource Caption}" Margin="0,14,0,0"
                               Text="No saved Windows credentials for servers yet." />
                    <ItemsControl x:Name="SavedList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentFg}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Target}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding User}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="&#xE74D;" ToolTip="Remove this credential"
                                                Click="RemoveCredential_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- more -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="More" />
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Tile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE895;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="Refresh Group Policy" FontWeight="SemiBold" />
                            <TextBlock Text="gpupdate /force – picks up GPO-deployed printers." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Run" VerticalAlignment="Center" Click="Gpupdate_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="Flush DNS cache" FontWeight="SemiBold" />
                            <TextBlock Text="Helps after a print server moved or changed IP." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Flush" VerticalAlignment="Center" Click="FlushDns_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="Copy printer list" FontWeight="SemiBold" />
                            <TextBlock Text="All printers with status, port and driver – paste into a ticket." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Copy" VerticalAlignment="Center" Click="CopyList_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE912;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="Print Management" FontWeight="SemiBold" />
                            <TextBlock Text="Opens the MMC console (Windows Pro / Enterprise)." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Open" VerticalAlignment="Center" Click="PrintMgmt_Click" />
                    </Grid>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
