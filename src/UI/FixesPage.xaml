<UserControl x:Class="PrinterUtility.FixesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrinterUtility">
    <UserControl.Resources>
        <DataTemplate x:Key="FixTemplate" DataType="{x:Type local:FixVm}">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource TonePill}" Margin="0,0,6,0" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Admin" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TonePill}" Tag="{x:Static local:Tone.Accent}" Margin="0,0,6,0"
                                    Visibility="{Binding PerUser, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Current user" />
                            </Border>
                            <Border Style="{StaticResource TonePill}" Tag="{x:Static local:Tone.Warning}" Margin="0,0,6,0"
                                    Visibility="{Binding HasSecurityNote, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Lowers security" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TonePill}" Margin="0,0,6,0" Visibility="{Binding RestartsSpooler, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Restarts spooler" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource TonePill}" Tag="{Binding StateTone}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding StateText}" />
                    </Border>
                    <ToggleButton Grid.Column="3" Style="{StaticResource Chevron}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" ToolTip="Details" />

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="34,14,8,4" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="13" Foreground="{DynamicResource TextSub}" />
                        <Border Style="{StaticResource ToneBanner}" Tag="{x:Static local:Tone.Warning}" Margin="0,12,0,0" Padding="12,10"
                                Visibility="{Binding HasSecurityNote, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource ToneIcon}" Tag="{x:Static local:Tone.Warning}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding SecurityNote}" Style="{StaticResource Body}" FontSize="13" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40" MaxWidth="1040">
            <TextBlock Text="Fix issues" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Known fixes for shared printers. Each fix shows whether it's already applied on this PC – expand it to see exactly what it changes." />

            <WrapPanel Margin="0,22,0,0">
                <Button Style="{StaticResource AccentButton}" Tag="&#xE90F;" Content="Apply selected" Margin="0,0,8,8" Click="Apply_Click" />
                <Button Tag="&#xE7A7;" Content="Revert selected" Margin="0,0,24,8" Click="Revert_Click" />
                <Button Style="{StaticResource SubtleButton}" Tag="&#xE7F8;" Content="Select for client PC" Margin="0,0,4,8" Click="SelectClient_Click"
                        ToolTip="Recommended fixes for a PC that connects to a shared printer" />
                <Button Style="{StaticResource SubtleButton}" Tag="&#xE968;" Content="Select for sharing PC" Margin="0,0,4,8" Click="SelectServer_Click"
                        ToolTip="Recommended fixes for the PC or server that shares the printer" />
                <Button Style="{StaticResource SubtleButton}" Tag="&#xE894;" Content="Clear" Margin="0,0,4,8" Click="Clear_Click" />
                <Button Style="{StaticResource SubtleButton}" Tag="&#xE72C;" Content="Re-check" Margin="0,0,4,8" Click="Recheck_Click" />
            </WrapPanel>

            <Border Style="{StaticResource ToneBanner}" Tag="{x:Static local:Tone.Accent}" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE82F;" Style="{StaticResource ToneIcon}" Tag="{x:Static local:Tone.Accent}" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Shared printer not working?" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,4,0,0"
                                   Text="1. On the PC that shares the printer: Select for sharing PC → Apply selected.&#x0a;2. On each PC that connects: Select for client PC → Apply selected, then add the printer again." />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Client – the PC that connects to a shared printer" />
            <ItemsControl x:Name="ClientList" ItemTemplate="{StaticResource FixTemplate}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Both – client and sharing PC" />
            <ItemsControl x:Name="BothList" ItemTemplate="{StaticResource FixTemplate}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Sharing PC / print server" />
            <ItemsControl x:Name="ServerList" ItemTemplate="{StaticResource FixTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
