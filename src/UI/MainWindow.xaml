<Window x:Class="PrinterUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrinterUtility"
        Title="Printer Utility" Width="1200" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== navigation -->
            <DockPanel Margin="10,10,6,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,22">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource OnAccent}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Printer Utility" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="IT printer toolkit" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" Margin="2,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="UserText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MachineText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="ElevationPill" Style="{StaticResource TonePill}" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ElevationText" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavPrinters" Style="{StaticResource NavItem}" Tag="&#xE749;" Content="Printers" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavShare" Style="{StaticResource NavItem}" Tag="&#xE72D;" Content="Share a printer" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFixes" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Fix issues" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Tools" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}" Tag="&#xE81C;" Checked="Nav_Checked" AutomationProperties.Name="Activity">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Activity" />
                            <Border x:Name="ErrorBadge" Style="{StaticResource TonePill}" Tag="{x:Static local:Tone.Error}" Margin="10,0,0,0"
                                    Padding="7,0,7,1" Visibility="Collapsed">
                                <TextBlock x:Name="ErrorBadgeText" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- ============================== content -->
            <Border Grid.Column="1" Background="{DynamicResource Bg}" Margin="0,0,0,0">
                <Grid>
                    <ContentControl x:Name="PageHost" Focusable="False" />
                    <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}" VerticalAlignment="Top" Visibility="Collapsed" />

                    <!-- toast -->
                    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,24"
                            CornerRadius="8" Padding="16,12,8,12" MaxWidth="760" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorder}" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ToastIcon" Style="{StaticResource ToneIcon}" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock x:Name="ToastText" Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <Button x:Name="ToastAction" Grid.Column="2" Style="{StaticResource SubtleButton}" Margin="12,0,0,0"
                                    Visibility="Collapsed" Click="ToastAction_Click" />
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="&#xE711;" Margin="4,0,0,0" Click="ToastClose_Click" ToolTip="Dismiss" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== dialog overlay -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource Scrim}" />
            <Border x:Name="DialogCard" Background="{DynamicResource Dialog}" CornerRadius="8" BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" MinWidth="440" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,22,24,22">
                        <TextBlock x:Name="DialogTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <ContentControl x:Name="DialogContent" Focusable="False" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource Bg}" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource Divider}" Padding="24,18">
                        <UniformGrid x:Name="DialogButtons" Rows="1" HorizontalAlignment="Stretch">
                            <Button x:Name="DialogPrimary" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Click="DialogPrimary_Click" />
                            <Button x:Name="DialogSecondary" Margin="4,0,0,0" Click="DialogSecondary_Click" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
