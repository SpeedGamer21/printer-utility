<UserControl x:Class="PrinterUtility.SharePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrinterUtility">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock Text="Share a printer" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Make a printer that's connected to this PC available to other computers on the network." />

            <!-- network profile banner -->
            <Border x:Name="NetBanner" Style="{StaticResource ToneBanner}" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NetIcon" Style="{StaticResource ToneIcon}" FontSize="20" Margin="0,0,14,0" Text="&#xE968;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NetTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="NetText" Style="{StaticResource Caption}" Margin="0,2,12,0" />
                    </StackPanel>
                    <Button x:Name="NetFix" Grid.Column="2" Tag="&#xEA18;" Content="Switch to Private" Margin="12,0,0,0"
                            Visibility="Collapsed" Click="NetFix_Click" />
                </Grid>
            </Border>

            <!-- step 1 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="1   Choose a printer on this PC" />
            <Grid>
                <ListBox x:Name="LocalList" Style="{StaticResource CardList}" MaxHeight="290" SelectionChanged="LocalList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ShareVm}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Width="36" Height="36">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFg}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource TonePill}" Tag="{x:Static local:Tone.Success}"
                                        Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Shared" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="NoLocal" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Caption}" FontSize="13"
                               Text="There are no physical printers installed on this PC (virtual printers like Microsoft Print to PDF can't be shared). Connect the printer by USB or install it by IP address first, then come back here." />
                </Border>
            </Grid>

            <!-- step 2 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="2   Sharing settings" />
            <Border x:Name="SettingsCard" Style="{StaticResource Card}" Padding="22,20" IsEnabled="False">
                <StackPanel>
                    <TextBlock Text="Share name" FontWeight="SemiBold" />
                    <TextBlock Text="The name other computers use to connect. Short names without spaces work best with older clients."
                               Style="{StaticResource Caption}" Margin="0,2,0,8" />
                    <TextBox x:Name="ShareName" Width="420" HorizontalAlignment="Left" Tag="e.g. Accounting-HP" TextChanged="ShareName_TextChanged" />
                    <TextBlock x:Name="ShareError" Foreground="{DynamicResource ErrorFg}" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed" />

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,20" />

                    <CheckBox x:Name="Prepare" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Prepare this PC as a print server (recommended)" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Turns on File and Printer Sharing in the firewall, lets the spooler accept remote connections, accepts RPC over TCP and named pipes, and makes sure the Spooler, Server and Workstation services are running. The spooler restarts once." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="Publish" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="List in Active Directory" />
                            <TextBlock x:Name="PublishHint" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Users can find the printer with Add printer → search the directory. Needs a domain-joined PC." />
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,20" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Other computers connect with" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="UncPreview" FontFamily="{StaticResource MonoFont}" FontSize="16" Margin="0,4,0,0"
                                       Foreground="{DynamicResource AccentFg}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Tag="&#xE8C8;" Content="Copy" VerticalAlignment="Center"
                                Click="CopyUnc_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="ShareBtn" Style="{StaticResource AccentButton}" Tag="&#xE72D;" Content="Share printer" Click="Share_Click" />
                        <Button x:Name="StopBtn" Style="{StaticResource DangerButton}" Tag="&#xE711;" Content="Stop sharing" Margin="8,0,0,0"
                                Click="Stop_Click" />
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Margin="16,0,6,0" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="Requires administrator rights" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- current shares -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Shared from this PC" />
            <ItemsControl x:Name="SharedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ShareVm}">
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" Foreground="{DynamicResource SuccessFg}" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Unc}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource TextSub}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="&#xE8C8;" ToolTip="Copy path" Click="CopyRow_Click" />
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="&#xE70F;" ToolTip="Edit" Margin="4,0,0,0" Click="EditRow_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoneShared" Style="{StaticResource Caption}" FontSize="13" Margin="2,0,0,0"
                       Text="Nothing is shared from this PC yet." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
