<UserControl x:Class="PrinterUtility.PrintersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrinterUtility">
    <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Printers" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AccentButton}" Tag="&#xE710;" Content="Add printer" Click="Add_Click" />
                <Button Tag="&#xE72C;" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Refresh (F5)" />
            </StackPanel>
            <TextBox x:Name="Search" HorizontalAlignment="Right" Width="280" Tag="Search printers" TextChanged="Search_TextChanged" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,4,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Let Windows manage my default printer" Style="{StaticResource Body}" />
                            <TextBlock Text="When on, Windows switches the default to the printer you used last. Turn it off to keep your choice."
                                       Style="{StaticResource Caption}" Margin="0,2,16,0" />
                        </StackPanel>
                        <CheckBox x:Name="ManagedToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Click="ManagedToggle_Click" />
                    </Grid>
                </Border>

                <Grid>
                    <ListBox x:Name="List" Style="{StaticResource CardList}" SelectionChanged="List_SelectionChanged"
                             MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PrinterVm}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentFg}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource TonePill}" Tag="{x:Static local:Tone.Accent}" Margin="0,0,6,0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Default" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource TonePill}" Tag="{x:Static local:Tone.Neutral}" Margin="0,0,6,0"
                                                Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Shared" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource TonePill}" Tag="{Binding StatusTone}">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyList" Text="No printers match your search." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <!-- detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                    <StackPanel x:Name="EmptyDetail" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="Select a printer" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Double-click a printer to make it your default." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" Width="56" Height="56" CornerRadius="12" HorizontalAlignment="Left">
                                <TextBlock x:Name="DGlyph" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentFg}" />
                            </Border>
                            <TextBlock x:Name="DName" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,14,0,8" />
                            <WrapPanel>
                                <Border x:Name="DDefaultPill" Style="{StaticResource TonePill}" Tag="{x:Static local:Tone.Accent}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Default printer" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="DStatusPill" Style="{StaticResource TonePill}">
                                    <TextBlock x:Name="DStatus" />
                                </Border>
                            </WrapPanel>

                            <Grid x:Name="Props" Margin="0,18,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <Button x:Name="BtnDefault" Style="{StaticResource AccentButton}" Tag="&#xE735;" Content="Set as default"
                                    HorizontalContentAlignment="Left" Margin="0,12,0,0" Click="SetDefault_Click" />
                            <Button Tag="&#xE749;" Content="Print test page" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="TestPage_Click" />
                            <Button Tag="&#xE8FD;" Content="Open print queue" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="Queue_Click" />
                            <Button Tag="&#xE894;" Content="Cancel all jobs" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="Purge_Click" />
                            <Button Tag="&#xE713;" Content="Printing preferences" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="Prefs_Click" />
                            <Button Tag="&#xE90F;" Content="Printer properties" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="Props_Click" />
                            <Button x:Name="BtnShare" Tag="&#xE72D;" Content="Share on the network" HorizontalContentAlignment="Left" Margin="0,6,0,0"
                                    Click="Share_Click" />
                            <Button Style="{StaticResource DangerButton}" Tag="&#xE74D;" Content="Remove printer" HorizontalContentAlignment="Left"
                                    Margin="0,6,0,0" Click="Remove_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
